<!-- Copied from dsr_description2/ros2_control/m1013.mj_ros2_control.xacro (humble@6c5f3ba); PID removed for real-robot mirroring -->
<robot name="m1013" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="$(find dsr_description2)/config/macro.gazebo.xacro" />
    <xacro:include filename="$(find dsr_description2)/config/macro.transmission.xacro" />
    <xacro:include filename="$(find dsr_description2)/config/macro.materials.xacro" />

    <xacro:property name="default_position_kp" value="2500" />
    <xacro:property name="default_position_ki" value="10" />
    <xacro:property name="default_position_kd" value="10" />
    <xacro:property name="default_position_i_max" value="1000" />
    <xacro:macro name="joint_pid_params" params="kp:=0 ki:=0 kd:=0 i_max:=0">
        <!-- mirror - no PID, mujoco_ros2_control writes qpos directly -->
        <command_interface name="position"/>
    </xacro:macro>
    
    <xacro:macro name="m1013_mj_ros2_control" params="
    name:=m1013
    namespace
    rate:=100
    standby:=true
    command:=none
    host:=0.0.0.0
    port:=12345
    mode:=real
    model:=m1013
    gripper:=none
    mobile:=none
    use_gazebo:=false
    update_rate
    ">

    <ros2_control name="MujocoSystem" type="system">
        <hardware>
            <plugin>mujoco_ros2_control/MujocoSystem</plugin>
        </hardware>

        <joint name="joint_1">
            <xacro:joint_pid_params />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>

        <joint name="joint_2">
            <xacro:joint_pid_params />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>

        <joint name="joint_3">
            <xacro:joint_pid_params />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>

        <joint name="joint_4">
            <xacro:joint_pid_params />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>

        <joint name="joint_5">
            <xacro:joint_pid_params />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>

        <joint name="joint_6">
            <xacro:joint_pid_params />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>

      <!-- 2f85 Mujoco ROS2 control -->
      <xacro:if value="${gripper == '2f85'}">
        <xacro:include filename="$(find dsr_description2)/ros2_control/robotiq_2f85.mj_ros2_control.xacro"/>
      </xacro:if>

    </ros2_control>

    <!-- Add dummy link for 2f85 Mujoco ROS2 control -->
    <xacro:if value="${gripper == '2f85'}">
        <xacro:include filename="$(find dsr_description2)/xacro/robotiq_2f85.xacro"/>
    </xacro:if>
    
    </xacro:macro>
</robot>